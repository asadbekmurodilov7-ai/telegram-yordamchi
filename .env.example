# Bu faylni .env nomi bilan nusxalang va o'z kalitlaringizni yozing.
# DIQQAT: .env faylini hech kimga bermang va GitHub'ga yuklamang!

# BotFather bergan token (majburiy)
BOT_TOKEN=123456:AAH...

# Sizning chat raqamingiz - botga /id yozsangiz chiqadi
ADMIN_CHAT_ID=0

# Claude API kaliti (ZAHIRA - hozircha ishlatilmaydi)
ANTHROPIC_API_KEY=

# Gemini API kaliti - barcha AI funksiyalar uchun (majburiy)
GEMINI_API_KEY=AIza...

# 1-kanal (asosiy yangiliklar kanali). Misol: @mening_kanalim yoki -1001234567890
NEWS_KANAL=@mening_kanalim

# 2-kanal - post joylashda tugma bilan tanlanadi (ixtiyoriy)
KANAL2=

# Avto yangiliklar kanali - AI dayjest tasdiqsiz to'g'ridan-to'g'ri shu kanalga joylanadi
AVTO_NEWS_KANAL=

# ---- Istorya (Telegram Stories) ----
# my.telegram.org -> API development tools
TG_API_ID=0
TG_API_HASH=
# `python story_login.py` chiqargan StringSession satri (SIR SAQLANADI)
TG_SESSION=
